erDiagram
    %% Layer 3: Ingestion and Time-Series Facts - clouDBills
    %% Partitioned tables: BILLING_RECORDS BY RANGE usage_start, USAGE_METRICS BY RANGE measured_at

    CLOUD_ACCOUNTS ||--o{ BILLING_IMPORT_BATCHES : "ingests"
    USERS ||--o{ BILLING_IMPORT_BATCHES : "imports"
    BILLING_IMPORT_BATCHES ||--o{ BILLING_STAGING : "lands"
    BILLING_IMPORT_BATCHES ||--o{ BILLING_IMPORT_ERRORS : "quarantines"
    BILLING_IMPORT_BATCHES ||--o{ BILLING_RECORDS : "produces"
    CLOUD_ACCOUNTS ||--o{ BILLING_RECORDS : "bills"
    RESOURCES |o--o{ BILLING_RECORDS : "charged_for_nullable"
    PROJECTS |o--o{ BILLING_RECORDS : "attributed_to_nullable"
    METRIC_TYPES ||--o{ USAGE_METRICS : "measures"
    RESOURCES ||--o{ USAGE_METRICS : "emits"
    RESOURCES ||--o{ RESOURCE_DAILY_SUMMARIES : "rolls_up"
    METRIC_TYPES ||--o{ RESOURCE_DAILY_SUMMARIES : "aggregates"

    CLOUD_ACCOUNTS {
        bigint account_id PK
    }
    USERS {
        bigint user_id PK
    }
    RESOURCES {
        bigint resource_id PK
    }
    PROJECTS {
        bigint project_id PK
    }
    BILLING_IMPORT_BATCHES {
        bigint batch_id PK
        bigint account_id FK
        bigint imported_by FK
        varchar file_name
        char file_checksum
        timestamp imported_at
        int row_count
        int accepted_count
        int rejected_count
        varchar status "uploaded,validating,validated,processed,failed"
    }
    BILLING_STAGING {
        bigint staging_id PK
        bigint batch_id FK
        text provider_name
        text external_account_id
        text external_resource_id
        text service_name
        text usage_start_text
        text usage_end_text
        text usage_quantity_text
        text billed_cost_text
        text currency_code_text
    }
    BILLING_IMPORT_ERRORS {
        bigint error_id PK
        bigint batch_id FK
        int raw_row_index
        jsonb raw_payload
        varchar error_code
        varchar error_message
        timestamp rejected_at
    }
    BILLING_RECORDS {
        bigint billing_id PK
        timestamp usage_start PK "partition key"
        bigint account_id FK
        bigint resource_id FK "NULLABLE"
        bigint project_id FK "NULLABLE"
        bigint source_batch_id FK
        varchar service_name
        timestamp usage_end
        decimal usage_quantity
        decimal billed_cost
        char currency_code
    }
    METRIC_TYPES {
        int metric_type_id PK
        varchar metric_name UK
        varchar unit "percent,bytes,iops,count"
        varchar aggregation_method "avg,max,sum"
    }
    USAGE_METRICS {
        bigint metric_id PK
        timestamp measured_at PK "partition key"
        bigint resource_id FK
        int metric_type_id FK
        decimal metric_value
    }
    RESOURCE_DAILY_SUMMARIES {
        bigint resource_id FK PK
        int metric_type_id FK PK
        date summary_date PK
        decimal avg_value
        decimal max_value
        decimal min_value
        int sample_count
    }
