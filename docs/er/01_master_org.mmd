erDiagram
    %% Layer 1: Master and Organizational Entities - clouDBills
    %% PK = Primary Key, FK = Foreign Key, UK = Unique/Candidate Key

    CLOUD_PROVIDERS ||--o{ CLOUD_ACCOUNTS : "offers"
    CLOUD_PROVIDERS ||--o{ REGIONS : "operates_in"
    CLOUD_PROVIDERS ||--o{ RESOURCE_TYPES : "defines"
    CLOUD_ACCOUNTS ||--o{ RESOURCES : "provisions"
    TEAMS ||--o{ PROJECTS : "owns"
    TEAMS ||--o{ BUDGETS : "funded_by"
    ENVIRONMENTS ||--o{ PROJECTS : "stages"
    PROJECTS ||--o{ RESOURCES : "groups"
    PROJECTS ||--o{ BUDGETS : "constrained_by"
    USERS ||--o{ TEAMS : "manages"
    USERS ||--o{ USER_ROLES : "assigned"
    ROLES ||--o{ USER_ROLES : "grants"

    CLOUD_PROVIDERS {
        int provider_id PK
        varchar provider_name UK
        varchar api_endpoint_url
        boolean is_active
    }
    CLOUD_ACCOUNTS {
        bigint account_id PK
        int provider_id FK
        varchar account_name
        varchar external_account_id
        char currency_code
        boolean is_active
    }
    USERS {
        bigint user_id PK
        varchar email UK
        varchar username
        varchar password_hash
        varchar first_name
        varchar last_name
        boolean is_active
        timestamp created_at
    }
    ROLES {
        int role_id PK
        varchar role_name UK
        varchar description
        jsonb permissions
    }
    USER_ROLES {
        bigint user_id FK PK
        int role_id FK PK
        timestamp assigned_at
    }
    TEAMS {
        bigint team_id PK
        varchar team_name UK
        varchar cost_center UK
        bigint manager_user_id FK
        timestamp created_at
    }
    PROJECTS {
        bigint project_id PK
        bigint team_id FK
        int environment_id FK
        varchar project_name
        varchar description
        boolean is_active
        timestamp created_at
    }
    ENVIRONMENTS {
        int environment_id PK
        varchar environment_code UK
        boolean is_production_grade
    }
    REGIONS {
        int region_id PK
        int provider_id FK
        varchar region_code
        varchar region_name
        varchar continent
        boolean is_active
    }
    RESOURCE_TYPES {
        int type_id PK
        int provider_id FK
        varchar raw_service_code
        varchar raw_type_name
        varchar generic_category
        varchar pricing_unit
    }
    %% Placeholder stubs to show cross-layer FKs without duplicating full definitions
    RESOURCES {
        bigint resource_id PK
        bigint account_id FK
        bigint project_id FK
    }
    BUDGETS {
        bigint budget_id PK
        bigint project_id FK
        bigint team_id FK
    }
